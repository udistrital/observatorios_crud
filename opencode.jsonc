{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "servers": {
      "gitnexus": {
        "type": "local",
        "command": ["gitnexus", "mcp"]
      }
    }
  },

  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "20%"
  },

  "tool_output": {
    "max_lines": 300,
    "max_bytes": 20000
  }
}
